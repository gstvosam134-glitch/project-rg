<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>生成历史 - <%= appName %></title><link rel="stylesheet" href="/public/css/app.css"></head><body><header class="topbar"><a class="brand" href="/"><span class="brand-mark">记</span><span><b><%= appName %></b><small>TRIAL OPERATION RECORDS</small></span></a><nav><a href="/">记录生成</a><a class="active" href="/history">生成历史</a></nav></header><main class="shell"><section class="panel"><p class="eyebrow">LOCAL HISTORY</p><h1>生成历史</h1><p>仅记录生成时间、模板、日期数量与文件名，不保存 Word 文件内容。</p><div class="table-wrap"><table><thead><tr><th>生成时间</th><th>模板</th><th>份数</th><th>文件名</th></tr></thead><tbody><% if(!logs.length){ %><tr><td colspan="4">暂无记录</td></tr><% } logs.forEach(log=>{ %><tr><td><%= new Date(log.created_at+'Z').toLocaleString('zh-CN') %></td><td><%= log.template_name %></td><td><%= log.date_count %></td><td><%= log.filename %></td></tr><% }) %></tbody></table></div></section></main></body></html>
