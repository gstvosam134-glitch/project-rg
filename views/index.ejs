<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= appName %></title><link rel="icon" href="/public/favicon.ico"><link rel="stylesheet" href="/public/css/app.css"><link rel="stylesheet" href="/public/css/record.css"></head><body>
<header class="topbar"><a class="brand" href="/"><span class="brand-mark">记</span><span><b><%= appName %></b><small>TRIAL OPERATION RECORDS</small></span></a><nav><a class="active" href="/">记录生成</a><a href="/history">生成历史</a></nav></header>
<main class="shell"><section class="hero"><div><p class="eyebrow">DOCUMENT WORKBENCH</p><h1>批量生成试运行情况记录表</h1><p>按工作日批量生成与正式表单一致的 Word，日期自动替换，其余内容由模板统一维护。</p></div><div class="hero-stat"><strong id="heroCount">0</strong><span>已选工作日</span></div></section>
<form class="workspace" method="post" action="/generate" id="generateForm"><aside class="panel side"><div class="section-title"><span>01</span><div><h2>选择模板</h2><p>切换已保存的填写方案</p></div></div><select id="templateSelect" name="template_id"><% templates.forEach(t=>{ %><option value="<%= t.id %>" <%= selected&&t.id===selected.id?'selected':'' %>><%= t.name %></option><% }) %></select><a class="text-link" href="#templateEditor">编辑当前模板 ↓</a><div class="section-title"><span>02</span><div><h2>选择工作日</h2><p>周末将自动排除</p></div></div><label>开始日期<input type="date" id="startDate" required></label><label>结束日期<input type="date" id="endDate" required></label><button type="button" class="secondary" id="calculate">计算工作日</button><div class="date-summary"><span>选中 <b id="selectedCount">0</b> 天</span><button type="button" class="link-button" id="clearDates">清空</button></div><div id="dateList" class="date-list"><p class="empty">设置日期范围后点击“计算工作日”</p></div></aside>
<section class="panel main-panel"><div class="section-head"><div><p class="eyebrow">LIVE PREVIEW</p><h2>正式表单预览</h2></div><span class="status-dot">模板已就绪</span></div><% const c=selected.content; %><div class="paper record-paper"><h2 id="previewTitle"><%= c.document_title %></h2><table class="record-table"><tbody><tr class="project-row"><td colspan="3"><b>项目名称：</b> <span data-preview="project_name"><%= c.project_name %></span></td></tr><tr><th class="vertical-label" rowspan="4">相<br>关<br>信<br>息</th><th>试运行时间</th><td id="previewDate">选择工作日后显示</td></tr><tr><th>建设单位</th><td data-preview="construction_unit"><%= c.construction_unit %></td></tr><tr><th>承建单位</th><td data-preview="contractor_unit"><%= c.contractor_unit %></td></tr><tr><th>监理单位</th><td data-preview="supervision_unit"><%= c.supervision_unit %></td></tr><tr class="operation-row"><th class="vertical-label">运<br>行<br>情<br>况</th><td colspan="2"><div data-preview="operation_content"><%= c.operation_content %></div></td></tr></tbody></table></div><div class="generate-bar"><div><b id="fileHint">尚未选择日期</b><small>单日下载 DOCX，多日自动打包 ZIP</small></div><button type="submit" id="generateButton" disabled>生成并下载 Word</button></div></section><div id="hiddenDates"></div></form>
<section class="panel editor" id="templateEditor"><div class="section-head"><div><p class="eyebrow">TEMPLATE SETTINGS</p><h2>自定义表单内容</h2><p>试运行时间由所选工作日自动填写；运行情况可选择文字后点击“加粗”。</p></div><span class="pill">SQLite 本地保存</span></div><form method="post" action="/templates" class="form-grid" id="templateForm"><input type="hidden" name="id" value="<%= selected.id %>"><label>模板名称<input name="name" value="<%= c.name %>" required></label><label>文档标题<input name="document_title" value="<%= c.document_title %>" required></label><label class="span-2">项目名称<input name="project_name" value="<%= c.project_name %>"></label><label>建设单位<input name="construction_unit" value="<%= c.construction_unit %>"></label><label>承建单位<input name="contractor_unit" value="<%= c.contractor_unit %>"></label><label>监理单位<input name="supervision_unit" value="<%= c.supervision_unit %>"></label><label class="span-2">运行情况<span class="editor-toolbar"><button type="button" class="format-button" id="boldSelection"><b>B</b> 加粗所选文字</button><small>加粗内容以 **文字** 标记，并同步到 Word</small></span><textarea class="operation-input" name="operation_content" id="operationContent"><%= c.operation_content %></textarea></label><div class="span-2 actions"><button type="submit">保存当前模板</button><button type="submit" class="secondary" formaction="/templates" onclick="this.form.id.value=''">另存为新模板</button></div></form></section></main><script src="/public/js/app.js"></script></body></html>
